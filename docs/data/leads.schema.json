{
 "fields": [
  {
   "name": "id",
   "type": "string",
   "constraints": {
    "required": true,
    "unique": true
   }
  },
  {
   "name": "tab",
   "type": "string",
   "constraints": {
    "required": true,
    "enum": [
     "revival",
     "import",
     "closing",
     "twins"
    ]
   }
  },
  {
   "name": "kind",
   "type": "string"
  },
  {
   "name": "title",
   "type": "string",
   "constraints": {
    "required": true
   }
  },
  {
   "name": "category",
   "type": "string"
  },
  {
   "name": "score",
   "type": "integer",
   "constraints": {
    "minimum": 0,
    "maximum": 100
   }
  },
  {
   "name": "date",
   "type": "string",
   "constraints": {
    "pattern": "^$|^[+-]?\\d{4}(-\\d{2}-\\d{2})?.*$"
   }
  },
  {
   "name": "trust_level",
   "type": "integer",
   "constraints": {
    "minimum": 1,
    "maximum": 3
   }
  },
  {
   "name": "freshness_level",
   "type": "integer",
   "constraints": {
    "minimum": 1,
    "maximum": 3
   }
  },
  {
   "name": "source_url",
   "type": "string",
   "constraints": {
    "required": true,
    "pattern": "^https://.*"
   }
  }
 ],
 "primaryKey": [
  "id"
 ]
}